{
  "expo": {
    "name": "Tambayan",
    "slug": "tambayan-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app_icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF9F4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tambayan.app"
    },
    "android": {
      "package": "com.tambayan.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF9F4",
        "foregroundImage": "./assets/images/app_icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to let you share posts and update your avatar."
        }
      ]
    ]
  }
}
